{
  "name": "@hizollo/games",
  "version": "2.5.0",
  "description": "A package that provides interfaces of various games.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsdown --watch",
    "build": "rm dist & tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiZollo/Games.git"
  },
  "keywords": [
    "games",
    "mini-games",
    "board-games"
  ],
  "author": "HiZollo Organization",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HiZollo/Games/issues"
  },
  "homepage": "https://github.com/HiZollo/Games#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
